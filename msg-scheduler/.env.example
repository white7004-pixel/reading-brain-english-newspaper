# 서버
PORT=3000
HOST=0.0.0.0
# 관리 화면 접속 비밀번호 (설정하면 브라우저가 아이디/비번을 묻습니다. 아이디는 아무거나)
APP_PASSWORD=
# 예약 시각의 기준 타임존
TZ_DEFAULT=Asia/Seoul
# 데이터 저장 위치 (기본: ./data)
# DATA_DIR=/var/lib/msg-scheduler

# ── 슬랙 ────────────────────────────────────────────────
# webhook(기본) 또는 bot
SLACK_MODE=webhook
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# ── 카카오워크 ──────────────────────────────────────────
KAKAOWORK_APP_KEY=
KAKAOWORK_DEFAULT_EMAIL=
KAKAOWORK_DEFAULT_CONVERSATION_ID=

# ── 카카오톡 (카카오 개발자센터 앱) ─────────────────────
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao/callback
# 아래 두 개는 [카카오 인증] 후 자동 저장되므로 비워두면 됩니다.
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# ── 텔레그램 (@BotFather 로 봇 생성) ────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ── 문자 (solapi 또는 twilio) ───────────────────────────
SMS_PROVIDER=solapi
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
SMS_DEFAULT_TO=

# ── 기타 웹훅 (디스코드/팀즈 등) ────────────────────────
WEBHOOK_URL=
WEBHOOK_BODY_TEMPLATE={"text":"{{message}}"}
WEBHOOK_HEADERS=
